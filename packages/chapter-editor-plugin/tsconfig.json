{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "moduleResolution": "node",
    "resolveJsonModule": true
  },
  "include": ["src/**/*"],
  // src/renderer is browser-side React code compiled by esbuild into its own
  // dist-renderer/ output (see tsconfig.renderer.json + the build:renderer
  // script) — kept out of this CommonJS pass so the two compilers never
  // write conflicting module formats into one outDir (the dual-compiler
  // dist clobber that hit MCP-Electron-App #186/#188).
  "exclude": ["node_modules", "dist", "dist-renderer", "src/renderer", "**/*.test.ts"]
}
