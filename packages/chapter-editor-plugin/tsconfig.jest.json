{
  // Dedicated ts-jest transform config for the renderer component test suite
  // (mirrors agent-factory-plugin's / kanban-plugin's tsconfig.jest.json).
  // tsconfig.renderer.json targets esbuild's ESM/bundler output; ts-jest
  // needs CommonJS so Jest's own require()-based runtime can load the
  // transformed test files. noEmit is flipped off because ts-jest rejects a
  // noEmit:true base config (it owns emission itself, in-memory, per test run).
  "extends": "./tsconfig.renderer.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "noEmit": false,
    "isolatedModules": true
  },
  "include": ["src/renderer/**/*"],
  "exclude": ["node_modules", "dist", "dist-renderer"]
}
